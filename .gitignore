# AGROSCOPE AI — Root .gitignore
# Comprehensive exclusion of secrets, environments, dependencies, and build artifacts.

# ── Secrets & Environment Variables ──────────────────────────────────────
.env
.env.*
!.env.example
!.env.local.example
*.key
*.secret
*.pem

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.log

# ── Node / Next.js ────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.vercel/

# ── IDE & OS ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── Scratch & Local Data ──────────────────────────────────────────────────
scratch/
backend/scratch/
backend/*.log
