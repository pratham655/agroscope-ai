# AGROSCOPE AI — backend .gitignore
# Keeps secrets and runtime artefacts out of version control.

# ── Secrets — NEVER commit these ─────────────────────────────────────────
.env
.env.local
.env.production
*.key
*.secret

# ── Python artefacts ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# ── Virtual environments ──────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Test / coverage ───────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.log

# ── IDE ───────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
