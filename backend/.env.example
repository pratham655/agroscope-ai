# Environment variables for AGROSCOPE AI backend
# Copy this file to backend/.env and fill in your values.
# NEVER commit a real .env file to version control.

# ── NASA APIs (no key required — both are publicly open) ──────────────────
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api
NASA_GIBS_WMTS_URL=https://gibs.earthdata.nasa.gov/wmts/epsg3857/best/wmts.cgi

# ── Optional: NASA Earthdata credentials (SMAP / ECOSTRESS) ──────────────
# Create a free account at https://urs.earthdata.nasa.gov/
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=

# ── OpenRouter AI — Farmer Action Copilot ────────────────────────────────
# Get a free key at https://openrouter.ai/keys
# Leave blank to run in fallback (rule-based) mode.
OPENROUTER_API_KEY=
# Any OpenRouter model identifier — default is Gemini Flash 1.5 (free tier)
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Max tokens the model may generate per response (keep ≤ 1000 for speed/cost)
OPENROUTER_MAX_TOKENS=800
# HTTP timeout in seconds
OPENROUTER_TIMEOUT_S=30.0

# ── CORS — frontend origin(s) ─────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ── Cache TTL in seconds (default 1 hour) ────────────────────────────────
CACHE_TTL_SECONDS=3600

# ── Demo mode (set False when live NASA integrations confirmed) ───────────
DEMO_MODE=true
